{
  "name": "@ninsei-labs/sdk",
  "version": "0.44.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.11.2",
  "description": "XMR <-> EVM swap engine: quotes, guards, order steps, recovery (no DOM, no user-facing strings)",
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "check": "node tools/check.mjs",
    "check:syntax": "node tools/check.mjs --only=syntax",
    "check:import": "node tools/check.mjs --only=import",
    "check:surface": "node tools/check.mjs --only=surface",
    "check:mirror": "node tools/check.mjs --only=mirror",
    "check:pack": "node tools/check.mjs --only=pack",
    "check:pack-teeth": "node tools/check-pack-teeth.mjs",
    "check:secrets": "node tools/check.mjs --only=secrets",
    "check:types": "node tools/check.mjs --only=types",
    "check:types-teeth": "node tools/check-types-teeth.mjs",
    "check:refusals": "node tools/check.mjs --only=refusals",
    "check:refusals-teeth": "node tools/check-refusals-teeth.mjs",
    "check:decline": "node tools/check.mjs --only=decline",
    "check:decline-teeth": "node tools/check-decline-teeth.mjs",
    "check:terminal": "node tools/check.mjs --only=terminal",
    "check:terminal-teeth": "node tools/check-terminal-teeth.mjs",
    "check:sweep": "node tools/sweep-refusal.test.mjs",
    "sync:version": "node tools/sync-version.mjs",
    "check:restore": "node tools/check-restore.mjs",
    "check:restore-height": "node tools/check-restore-height.mjs",
    "check:wallet-factory": "node tools/check-wallet-factory.mjs",
    "check:xmr-amount": "node tools/check-xmr-amount.mjs",
    "check:sign-preview": "node tools/check-sign-preview.mjs",
    "check:destination": "node tools/check-destination.mjs",
    "check:codes-meta": "node tools/check-codes-meta.mjs",
    "check:arrival-read": "node tools/check-arrival-read.mjs",
    "check:daemon-address": "node tools/check-daemon-address.mjs",
    "check:ci-scripts": "node tools/check-ci-scripts.mjs",
    "check:fee-estimate": "node tools/check-fee-estimate.mjs",
    "check:deadline-scale": "node tools/check-deadline-scale.mjs",
    "check:node-probe": "node tools/check-node-probe.mjs"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./adapters": {
      "default": "./src/adapters/index.mjs"
    },
    "./xmr": {
      "types": "./src/public/xmr.d.ts",
      "default": "./src/public/xmr.mjs"
    },
    "./order": {
      "types": "./src/public/order.d.ts",
      "default": "./src/public/order.mjs"
    },
    "./evm": {
      "types": "./src/public/evm.d.ts",
      "default": "./src/public/evm.mjs"
    },
    "./core": {
      "types": "./src/public/core.d.ts",
      "default": "./src/public/core.mjs"
    },
    "./networks": {
      "types": "./src/public/networks.d.ts",
      "default": "./src/public/networks.mjs"
    },
    "./recovery": {
      "types": "./src/public/recovery.d.ts",
      "default": "./src/public/recovery.mjs"
    },
    "./provider": {
      "types": "./src/public/provider.d.ts",
      "default": "./src/public/provider.mjs"
    }
  },
  "files": [
    "src",
    "engine",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "xmr",
    "monero",
    "evm",
    "ethereum",
    "atomic-swap",
    "cross-chain",
    "swap",
    "sdk",
    "quotes",
    "guards",
    "recovery",
    "esm",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ninsei-Labs/sdk.git"
  },
  "homepage": "https://github.com/Ninsei-Labs/sdk#readme",
  "bugs": {
    "url": "https://github.com/Ninsei-Labs/sdk/issues"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "keccak256": "^1.0.6"
  },
  "sideEffects": false
}
