{
  "name": "@ninsei-labs/sdk",
  "version": "0.53.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.11.2",
  "description": "XMR <-> EVM swap engine: quotes, guards, order steps, recovery (no DOM, no user-facing strings)",
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "scripts": {
    "check": "node tools/check.mjs",
    "check:syntax": "node tools/check.mjs --only=syntax",
    "check:import": "node tools/check.mjs --only=import",
    "check:surface": "node tools/check.mjs --only=surface",
    "check:mirror": "node tools/check.mjs --only=mirror",
    "check:pack": "node tools/check.mjs --only=pack",
    "check:pack-teeth": "node tools/check-pack-teeth.mjs",
    "check:secrets": "node tools/check.mjs --only=secrets",
    "check:types": "node tools/check.mjs --only=types",
    "check:types-teeth": "node tools/check-types-teeth.mjs",
    "check:refusals": "node tools/check.mjs --only=refusals",
    "check:refusals-teeth": "node tools/check-refusals-teeth.mjs",
    "check:decline": "node tools/check.mjs --only=decline",
    "check:decline-teeth": "node tools/check-decline-teeth.mjs",
    "check:terminal": "node tools/check.mjs --only=terminal",
    "check:terminal-teeth": "node tools/check-terminal-teeth.mjs",
    "check:sweep": "node tools/sweep-refusal.test.mjs",
    "check:sweep-half": "node tools/check-sweep-half.mjs",
    "sync:version": "node tools/sync-version.mjs",
    "check:restore": "node tools/check-restore.mjs",
    "check:restore-height": "node tools/check-restore-height.mjs",
    "check:wallet-factory": "node tools/check-wallet-factory.mjs",
    "check:xmr-amount": "node tools/check-xmr-amount.mjs",
    "check:sign-preview": "node tools/check-sign-preview.mjs",
    "check:destination": "node tools/check-destination.mjs",
    "check:codes-meta": "node tools/check-codes-meta.mjs",
    "check:arrival-read": "node tools/check-arrival-read.mjs",
    "check:sale-auth": "node tools/check-sale-auth.mjs",
    "check:backup-confirmation": "node tools/check-backup-confirmation.mjs",
    "check:key-view": "node tools/check-key-view.mjs",
    "check:relay-view": "node tools/check-relay-view.mjs",
    "check:relay-terms": "node tools/check-relay-terms.mjs",
    "check:relay-features": "node tools/check-relay-features.mjs",
    "check:relay-request": "node tools/check-relay-request.mjs",
    "check:relay-answer": "node tools/check-relay-answer.mjs",
    "check:relay-http": "node tools/check-relay-http.mjs",
    "check:relay-adapter": "node tools/check-relay-adapter.mjs",
    "check:arrival-consensus": "node tools/check-arrival-consensus.mjs",
    "check:arrival-real": "node tools/check-arrival-real.mjs",
    "check:order-proof": "node tools/check-order-proof.mjs",
    "check:daemon-address": "node tools/check-daemon-address.mjs",
    "check:ci-scripts": "node tools/check-ci-scripts.mjs",
    "check:factory-selectors": "node tools/check-factory-selectors.mjs",
    "check:fee-estimate": "node tools/check-fee-estimate.mjs",
    "check:deadline-scale": "node tools/check-deadline-scale.mjs",
    "check:node-probe": "node tools/check-node-probe.mjs",
    "check:recovery-key": "node tools/check.mjs --only=recovery-key",
    "check:recovery-open": "node tools/check-recovery-open.mjs",
    "check:contract-vectors": "node tools/check-contract-vectors.mjs",
    "check:live-contract": "node tools/check-live-contract.mjs",
    "check:anvil-fork": "node tools/check-anvil-fork.mjs",
    "check:dex": "node tools/check.mjs --only=cow,cow-refusal,kyber,kyber-refusal,uniswapx,uniswapx-refusal,uniswap-relay,uniswap-relay-refusal",
    "check:anvil-uniswap": "node tools/check-anvil-uniswap.mjs",
    "check:atomic-flow": "node tools/check-atomic-flow.mjs",
    "check:packed-consumer": "node tools/check-packed-consumer.mjs",
    "check:quote-binding": "node tools/check-quote-binding.mjs",
    "check:types-consumer": "node node_modules/typescript/bin/tsc -p tools/ts-consumer/tsconfig.json",
    "check:monero-live": "node tools/check-monero-live.mjs"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./adapters": {
      "default": "./src/adapters/index.mjs"
    },
    "./xmr": {
      "types": "./src/public/xmr.d.ts",
      "default": "./src/public/xmr.mjs"
    },
    "./order": {
      "types": "./src/public/order.d.ts",
      "default": "./src/public/order.mjs"
    },
    "./evm": {
      "types": "./src/public/evm.d.ts",
      "default": "./src/public/evm.mjs"
    },
    "./core": {
      "types": "./src/public/core.d.ts",
      "default": "./src/public/core.mjs"
    },
    "./networks": {
      "types": "./src/public/networks.d.ts",
      "default": "./src/public/networks.mjs"
    },
    "./recovery": {
      "types": "./src/public/recovery.d.ts",
      "default": "./src/public/recovery.mjs"
    },
    "./provider": {
      "types": "./src/public/provider.d.ts",
      "default": "./src/public/provider.mjs"
    }
  },
  "files": [
    "src",
    "engine",
    "assets",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "keywords": [
    "xmr",
    "monero",
    "evm",
    "ethereum",
    "atomic-swap",
    "cross-chain",
    "swap",
    "sdk",
    "quotes",
    "guards",
    "recovery",
    "esm",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ninsei-Labs/sdk.git"
  },
  "homepage": "https://github.com/Ninsei-Labs/sdk#readme",
  "bugs": {
    "url": "https://github.com/Ninsei-Labs/sdk/issues"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "1.8.0",
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip39": "2.4.0",
    "keccak256": "^1.0.6"
  },
  "sideEffects": false,
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
